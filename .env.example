APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

HORIZON_ALLOWED_EMAILS=
PULSE_ALLOWED_EMAILS=

PULSE_DB_CONNECTION=pulse
PULSE_DB_DATABASE=laravel_pulse

REVERB_APP_ID=123456
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8081
REVERB_CLIENT_SCHEME=http
REVERB_SCALING_ENABLED=true

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker Compose local (docker compose up --build) ---
# Valores acima já estão configurados para o stack local (postgres, redis, reverb).
# Sem Docker: use DB_CONNECTION=sqlite, SESSION_DRIVER=database, CACHE_STORE=database,
# REDIS_HOST=127.0.0.1 e BROADCAST_CONNECTION=log.
#
# --- Dokploy Stack (staging / production) ---
# Checklist:
# 1. Compose Type: Stack | Provider: GitHub (não Raw)
# 2. Staging: branch develop, compose path ./docker-compose.staging.yml
# 3. Production: branch main (ou tag), compose path ./docker-compose.production.yml
# 4. Autodeploy: OFF — deploy somente via GitHub Actions (compose.deploy)
# 5. Environment tab: vars abaixo + DOCKER_IMAGE (Dokploy gera o .env; compose usa env_file)
# 6. Domains tab: serviço web porta 8080; reverb paths /app e /apps porta 8080 (mesmo host)
# 7. Postgres/Redis: serviços do ambiente (não estão no stack)
# 8. Registry GHCR (Advanced): username + PAT read:packages se imagem privada
# GitHub Variables: DOKPLOY_URL, DOKPLOY_STAGING_STACK_ID (composeId), DOKPLOY_PRODUCTION_STACK_ID
# GitHub Secret: DOKPLOY_API_KEY
#
# Stack ID: URL .../services/compose/<ID> ou api/project.all
#
# DOCKER_IMAGE=ghcr.io/<owner>/<repo>:staging
# DOCKER_IMAGE=ghcr.io/<owner>/<repo>:latest   (production)
#
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:...
# APP_URL=https://example.com
#
# DB_CONNECTION=pgsql
# DB_HOST=<host-postgres-do-ambiente>
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=laravel
# DB_PASSWORD=
#
# PULSE_DB_CONNECTION=pulse
# PULSE_DB_DATABASE=laravel_pulse
# (crie o database laravel_pulse no Postgres do ambiente; migrate no web cuida das tabelas pulse_*)
#
# Local: deixe vazio — /horizon e /pulse abertos sem login (APP_ENV=local).
# Dokploy: defina e-mails separados por vírgula.
# HORIZON_ALLOWED_EMAILS=admin@example.com
# PULSE_ALLOWED_EMAILS=admin@example.com,dev@example.com
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# BROADCAST_CONNECTION=reverb
#
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=reverb
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_CLIENT_HOST=example.com
# REVERB_CLIENT_PORT=443
# REVERB_CLIENT_SCHEME=https
# REVERB_SCALING_ENABLED=true
#
# REDIS_HOST=<host-redis-do-ambiente>
# REDIS_PASSWORD=null
# REDIS_PORT=6379
#
# SSL_MODE=off
# HEALTHCHECK_PATH=/up
# PHP_OPCACHE_ENABLE=1
#
# AUTORUN_* ficam no compose (web/worker/cron), não na Environment tab.
